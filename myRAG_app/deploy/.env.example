# Required: OpenAI API key used by RAG backend and VPS vector build stage
OPENAI_API_KEY=sk-xxxx

# VPS absolute path to Chroma vector DB built on VPS
MYRAG_DB_PATH=/srv/myrag/vector_db

# Chroma collection name
MYRAG_COLLECTION=myrag_docs

# Comma-separated origins for CORS at API layer
MYRAG_ALLOWED_ORIGINS=http://154.12.245.254

# Optional: Ollama endpoint used when UI selects qwen3:latest or llama3.2:latest
# If API runs in Docker and Ollama runs on host, use the host bridge IP (commonly 172.17.0.1).
OLLAMA_URL=http://172.17.0.1:11434

# Optional: PostgreSQL + pgvector thread memory
MYRAG_THREADS_ENABLED=0
# For Docker API container on VPS host DB, use host.docker.internal (requires docker-compose extra_hosts).
MYRAG_THREADS_DB_HOST=host.docker.internal
MYRAG_THREADS_DB_PORT=5432
MYRAG_THREADS_DB_NAME=myRAG_threads
MYRAG_THREADS_DB_USER=postgresql
MYRAG_THREADS_DB_PASSWORD=postgresql
MYRAG_THREADS_DB_SSLMODE=disable
MYRAG_THREADS_VECTOR_DIMS=3072
MYRAG_THREADS_RECENT_MESSAGES=10
MYRAG_THREADS_SEMANTIC_TOP_K=6
MYRAG_THREADS_MAX_HISTORY_MESSAGES=24

# UI build settings for reverse-proxy path deployment
# Keep /RAG-mat unless you intentionally change reverse-proxy route.
MYRAG_BASE_PATH=/RAG-mat
VITE_BASE_PATH=/RAG-mat/
VITE_API_BASE_URL=/RAG-mat
