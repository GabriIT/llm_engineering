FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    python-dotenv \
    langchain \
    langchain-core \
    langchain-openai \
    langchain-chroma \
    chromadb \
    langchain-text-splitters \
    openai \
    tiktoken

COPY myRAG_app /app/myRAG_app

EXPOSE 8000

CMD ["python", "-m", "myRAG_app.api.server", "--host", "0.0.0.0", "--port", "8000"]
